# Copy to `.env` in this same folder. `.env` is git-ignored. Vite only exposes vars prefixed VITE_.

# EmployeeService's path-base root (see Backend/EmployeeService/Program.cs's UsePathBase) — every
# call in src/services/employeeService.js is relative to this, including its own "/api/..." segment.
VITE_EMPLOYEE_API=http://localhost:5285/api/employee-service

# Fallback only — used if this remote somehow runs outside the host shell (window.__omniremitHost__
# missing). Normally the host's own AuthService URL is read from the bridge instead, see src/api/authApi.js.
VITE_AUTH_API=http://localhost:5155
