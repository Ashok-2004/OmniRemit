# Copy to `.env` in this same folder. `.env` is git-ignored. Vite only exposes vars prefixed VITE_.

# Product name shown in the sidebar, login form and dashboard footer. Defaults to "OmniRemit".
# Set this to the deploying bank's own name to white-label the console.
VITE_APP_NAME=

# Build identifier shown in the dashboard footer, e.g. a CI build number or short git SHA.
# Left blank the footer simply omits it rather than inventing a version.
VITE_APP_VERSION=

# Base URLs the host calls. No trailing slash.
VITE_AUTH_SERVICE_URL=http://localhost:5155
VITE_MODULE_REGISTRY_URL=http://localhost:5200

# Optional — Google OAuth Client ID (same one configured in Backend/AuthService/.env's
# Google__ClientId). Leave blank to keep "Sign in with Google" showing an honest "not configured"
# state instead of a broken button.
VITE_GOOGLE_CLIENT_ID=
